package view

import ui "github.com/themartian0x48/ui/go"

templ IconDemo() {
	<section class="doc-section">
		<header class="doc-section__header">
			<h1 class="doc-section__title">Icon</h1>
			<p class="doc-section__description">
				A collection of essential SVG icons designed to be clear and consistent across the UI.
			</p>
		</header>
		<div class="doc-demo">
			<div class="doc-demo__preview">
				<!-- Sizes -->
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Sizes</h3>
					<div class="doc-demo__list" style="align-items: center;">
						<div class="doc-demo__item-label">
							@ui.Icon(ui.IconProp{Icon: ui.IconSettings(), Size: ui.IconSizeSM})
							<span>Small (16px)</span>
						</div>
						<div class="doc-demo__item-label">
							@ui.Icon(ui.IconProp{Icon: ui.IconSettings(), Size: ui.IconSizeMD})
							<span>Medium (24px)</span>
						</div>
						<div class="doc-demo__item-label">
							@ui.Icon(ui.IconProp{Icon: ui.IconSettings(), Size: ui.IconSizeLG})
							<span>Large (32px)</span>
						</div>
					</div>
				</div>
				<!-- All Icons -->
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Actions &amp; UI</h3>
					<div class="icon-grid">
						@iconBox("Check", ui.IconCheck())
						@iconBox("X", ui.IconX())
						@iconBox("Plus", ui.IconPlus())
						@iconBox("Minus", ui.IconMinus())
						@iconBox("Edit", ui.IconEdit())
						@iconBox("Trash", ui.IconTrash())
						@iconBox("Copy", ui.IconCopy())
						@iconBox("Search", ui.IconSearch())
						@iconBox("Filter", ui.IconFilter())
						@iconBox("Refresh", ui.IconRefresh())
						@iconBox("Share", ui.IconShare())
						@iconBox("Download", ui.IconDownload())
						@iconBox("Upload", ui.IconUpload())
						@iconBox("UploadCloud", ui.IconUploadCloud())
						@iconBox("Send", ui.IconSend())
						@iconBox("ExternalLink", ui.IconExternalLink())
						@iconBox("ArrowUpRight", ui.IconArrowUpRight())
						@iconBox("Sliders", ui.IconSliders())
						@iconBox("RotateCcw", ui.IconRotateCcw())
						@iconBox("RotateCw", ui.IconRotateCw())
						@iconBox("ZoomIn", ui.IconZoomIn())
						@iconBox("ZoomOut", ui.IconZoomOut())
						@iconBox("Maximize", ui.IconMaximize())
						@iconBox("Minimize", ui.IconMinimize())
						@iconBox("Eye", ui.IconEye())
						@iconBox("Link", ui.IconLink())
						@iconBox("Paperclip", ui.IconPaperclip())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Navigation &amp; Direction</h3>
					<div class="icon-grid">
						@iconBox("ArrowLeft", ui.IconArrowLeft())
						@iconBox("ArrowRight", ui.IconArrowRight())
						@iconBox("ArrowUp", ui.IconArrowUp())
						@iconBox("ArrowDown", ui.IconArrowDown())
						@iconBox("ChevronLeft", ui.IconChevronLeft())
						@iconBox("ChevronRight", ui.IconChevronRight())
						@iconBox("ChevronUp", ui.IconChevronUp())
						@iconBox("ChevronDown", ui.IconChevronDown())
						@iconBox("MoreHorizontal", ui.IconMoreHorizontal())
						@iconBox("MoreVertical", ui.IconMoreVertical())
						@iconBox("Home", ui.IconHome())
						@iconBox("Menu", ui.IconMenu())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Status &amp; Feedback</h3>
					<div class="icon-grid">
						@iconBox("Info", ui.IconInfo())
						@iconBox("Warning", ui.IconWarning())
						@iconBox("AlertCircle", ui.IconAlertCircle())
						@iconBox("CheckCircle", ui.IconCheckCircle())
						@iconBox("XCircle", ui.IconXCircle())
						@iconBox("HelpCircle", ui.IconHelpCircle())
						@iconBox("Loader", ui.IconLoader())
						@iconBox("Bell", ui.IconBell())
						@iconBox("Shield", ui.IconShield())
						@iconBox("Lock", ui.IconLock())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Users &amp; Communication</h3>
					<div class="icon-grid">
						@iconBox("User", ui.IconUser())
						@iconBox("Users", ui.IconUsers())
						@iconBox("UserPlus", ui.IconUserPlus())
						@iconBox("Mail", ui.IconMail())
						@iconBox("Phone", ui.IconPhone())
						@iconBox("MessageCircle", ui.IconMessageCircle())
						@iconBox("Heart", ui.IconHeart())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Files &amp; Data</h3>
					<div class="icon-grid">
						@iconBox("File", ui.IconFile())
						@iconBox("FileText", ui.IconFileText())
						@iconBox("Folder", ui.IconFolder())
						@iconBox("Image", ui.IconImage())
						@iconBox("Camera", ui.IconCamera())
						@iconBox("Package", ui.IconPackage())
						@iconBox("Layers", ui.IconLayers())
						@iconBox("Database", ui.IconDatabase())
						@iconBox("Server", ui.IconServer())
						@iconBox("Cloud", ui.IconCloud())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Layout &amp; Display</h3>
					<div class="icon-grid">
						@iconBox("Layout", ui.IconLayout())
						@iconBox("Grid", ui.IconGrid())
						@iconBox("ListBullet", ui.IconListBullet())
						@iconBox("Tag", ui.IconTag())
						@iconBox("Bookmark", ui.IconBookmark())
						@iconBox("Star", ui.IconStar())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Analytics &amp; Commerce</h3>
					<div class="icon-grid">
						@iconBox("Activity", ui.IconActivity())
						@iconBox("BarChart", ui.IconBarChart())
						@iconBox("TrendingUp", ui.IconTrendingUp())
						@iconBox("TrendingDown", ui.IconTrendingDown())
						@iconBox("DollarSign", ui.IconDollarSign())
						@iconBox("CreditCard", ui.IconCreditCard())
						@iconBox("ShoppingCart", ui.IconShoppingCart())
						@iconBox("ShoppingBag", ui.IconShoppingBag())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Media &amp; Devices</h3>
					<div class="icon-grid">
						@iconBox("Play", ui.IconPlay())
						@iconBox("Pause", ui.IconPause())
						@iconBox("SkipForward", ui.IconSkipForward())
						@iconBox("SkipBack", ui.IconSkipBack())
						@iconBox("Volume2", ui.IconVolume2())
						@iconBox("VolumeX", ui.IconVolumeX())
						@iconBox("Mic", ui.IconMic())
						@iconBox("Airplay", ui.IconAirplay())
						@iconBox("Monitor", ui.IconMonitor())
						@iconBox("Smartphone", ui.IconSmartphone())
					</div>
				</div>
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">System &amp; Misc</h3>
					<div class="icon-grid">
						@iconBox("Settings", ui.IconSettings())
						@iconBox("Power", ui.IconPower())
						@iconBox("Wifi", ui.IconWifi())
						@iconBox("Globe", ui.IconGlobe())
						@iconBox("MapPin", ui.IconMapPin())
						@iconBox("Calendar", ui.IconCalendar())
						@iconBox("Clock", ui.IconClock())
						@iconBox("LogOut", ui.IconLogOut())
						@iconBox("Sun", ui.IconSun())
						@iconBox("Moon", ui.IconMoon())
					</div>
				</div>
				<!-- Real-world Examples -->
				<div class="doc-demo__group">
					<h3 class="doc-demo__group-title">Real-world Usage</h3>
					<div class="doc-demo__list">
						@ui.Button(ui.ButtonProp{Variant: ui.ButtonPrimary}) {
							@ui.Icon(ui.IconProp{Icon: ui.IconDownload(), Size: ui.IconSizeSM})
							Download File
						}
						@ui.Button(ui.ButtonProp{Variant: ui.ButtonSecondary}) {
							@ui.Icon(ui.IconProp{Icon: ui.IconSettings(), Size: ui.IconSizeSM})
							Settings
						}
						<div style="display: flex; gap: var(--spacing-4); align-items: center; padding: var(--spacing-4); background: var(--color-bg-secondary); border-radius: var(--radius-default);">
							@ui.Icon(ui.IconProp{BaseProp: ui.BaseProp{Class: "text-primary"}, Icon: ui.IconCalendar()})
							<span class="text-secondary">Project Due: Dec 24, 2026</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<style type="text/css">
		.icon-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
			gap: var(--spacing-4);
			width: 100%;
		}
		.icon-box {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: var(--spacing-2);
			padding: var(--spacing-4);
			background: var(--color-bg);
			border: var(--border-width-default) solid var(--color-border);
			border-radius: var(--radius-default);
			transition: all var(--transition-base);
		}
		.icon-box:hover {
			border-color: var(--color-primary);
			color: var(--color-primary);
			transform: translateY(calc(-1 * var(--spacing-px)));
		}
		.icon-box__name {
			font-size: var(--font-size-xs);
			color: var(--color-text-muted);
		}
		.icon-box:hover .icon-box__name {
			color: var(--color-primary);
		}
		.text-primary { color: var(--color-primary); }
		.text-secondary { color: var(--color-text-secondary); }
	</style>
}

templ iconBox(name string, kind templ.Component) {
	<div class="icon-box">
		@ui.Icon(ui.IconProp{Icon: kind, Size: ui.IconSizeMD})
		<span class="icon-box__name">{ name }</span>
	</div>
}
