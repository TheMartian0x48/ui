package ui

import "strings"

// IconSize defines the bounding box dimensions of the SVG icon.
type IconSize int

const (
	IconSizeMD IconSize = iota // Standard 24px (default)
	IconSizeSM                 // Compact 16px
	IconSizeLG                 // Prominent 32px
)

// IconProp configures the SVG icon wrapper.
type IconProp struct {
	BaseProp                    // Standard Id, Class, and Attributes
	Icon       templ.Component  // The raw SVG component to render
	Size       IconSize         // Size variant
	AriaLabel  string           // Hidden label for accessibility (required for meaningful icons)
}

// Icon renders a themeable SVG icon with consistent sizing.
//
// By default, icons are hidden from screen readers (aria-hidden). Set
// AriaLabel if the icon conveys specific meaning or lacks adjacent text.
//
// Usage:
//   @ui.Icon(ui.IconProp{Icon: ui.IconCheck(), Size: ui.IconSizeMD})
templ Icon(prop IconProp) {
	<span
		if prop.Id != "" {
			id={ prop.Id }
		}
		class={ iconClass(prop) }
		if prop.AriaLabel != "" {
			role="img"
			aria-label={ prop.AriaLabel }
		} else {
			aria-hidden="true"
		}
		{ prop.Attributes... }
	>
		if prop.Icon != nil {
			@prop.Icon
		}
	</span>
}

func iconClass(prop IconProp) string {
	var b strings.Builder
	b.Grow(25)

	b.WriteString("icon")

	switch prop.Size {
	case IconSizeSM:
		b.WriteString(" icon--sm")
	case IconSizeLG:
		b.WriteString(" icon--lg")
	default:
		b.WriteString(" icon--md")
	}

	if prop.Class != "" {
		b.WriteString(" ")
		b.WriteString(prop.Class)
	}

	return b.String()
}

// ========== Individual Icon Components ==========

// IconCamera returns a modern camera icon SVG.
templ IconCamera() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
	</svg>
}

