		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3l14 9-14 9V3z"></path>
	</svg>
}

// IconSkipForward returns a skip-forward icon SVG.
templ IconSkipForward() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 4l10 8-10 8V4zM19 5v14"></path>
	</svg>
}

// IconSkipBack returns a skip-back icon SVG.
templ IconSkipBack() {
	<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20L9 12l10-8v16zM5 19V5"></path>
	</svg>
}

